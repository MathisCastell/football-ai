# Football.AI - Configuration
#
# Copie ce fichier en .env et configure tes cles :
#   cp .env.example .env
#
# ── Base de donnees ──
# Laisse vide en local : le service utilise automatiquement un fichier SQLite
# (football.db) sans configuration. En production (Render), cette variable est
# injectee automatiquement par le blueprint render.yaml (base Postgres gratuite).
DATABASE_URL=

# Intervalle (en heures) entre deux cycles automatiques du pipeline
PIPELINE_INTERVAL_HOURS=6

# Nombre minimum de predictions notees avant d'activer la calibration automatique
MIN_SAMPLES_FOR_CALIBRATION=40

# ── Comptes / freemium ──
# Cle de signature des sessions. Laisse vide en local (valeur aleatoire generee
# au demarrage). En production, Render la genere et la garde automatiquement
# (voir render.yaml, generateValue) - ne jamais la committer.
SECRET_KEY=

# Compte admin cree automatiquement au demarrage s'il n'existe pas deja.
# Laisse vide en local si tu n'as pas besoin d'un compte admin tout de suite.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Championnats accessibles aux comptes gratuits (liste separee par des virgules).
# Les autres championnats + l'analyse avancee + les conseils de paris + la page
# "Fiabilite du modele" sont reserves aux comptes premium.
FREE_COMPETITIONS=Premier League,Ligue 1

# ── API Football (optionnel) ──
# Inscription gratuite : https://www.football-data.org/
# Sans cle = donnees reelles recuperees gratuitement via TheSportsDB (5 grands
# championnats, sans inscription).
FOOTBALL_API_KEY=ta_cle_api_ici

# ── Bot Discord ──
# 1. Va sur https://discord.com/developers/applications
# 2. Cree une application > Bot > copie le token
# 3. Active "Message Content Intent" dans Privileged Gateway Intents
# 4. Invite le bot : OAuth2 > URL Generator > scopes: bot + applications.commands
#    Permissions: Send Messages, Embed Links, Use Slash Commands
DISCORD_TOKEN=ton_token_discord_ici

# ID de ton serveur Discord (pour sync instantanée des commandes slash)
# Clic droit sur ton serveur > "Copier l'identifiant du serveur"
# (Active le mode développeur dans Discord: Paramètres > Avancés > Mode développeur)
DISCORD_GUILD_ID=ton_id_serveur_ici
